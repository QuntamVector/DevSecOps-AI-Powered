pipeline{
    agent any

    tools {
        maven 'maven'
        jdk 'java-17'
    }

    stages{
        stage('Git-Checkout'){
            steps{
                git url: 'https://github.com/QuntamVector/DevSecOps-AI-Powered.git', branch: 'main'
            }
        }

        stage('Compile'){
            steps{
                sh '''
                    echo "Compiling the code..."
                    # Add your compilation commands here
                    mvn compile
                '''
            }
        }

        stage('Build'){
            steps{
                sh '''
                    echo "Building the application..."
                    # Add your build commands here
                    mvn package
                '''
            }
        }

        stage('Docker build'){
            steps{
                sh '''
                    printenv
                    echo "Building the Docker image..."
                    # Add your Docker build commands here
                    docker build -t devops:latest .
                '''
            }
        }
    }
}